          ]
        },
        "approvals_reviewer": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type"
      ],
      "unevaluatedProperties": false
    },
    {
      "type": "object",
      "allOf": [
        {
