          ]
        },
        "pre_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "post_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "type"
      ],
