{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tsconfigdotjson/agenttail/spec/schema/status.schema.json",
  "title": "agenttail status checkpoint (v0.1)",
  "description": "One line of a fixture expected/status.jsonl: a timing instruction and an optional expected status.",
  "$defs": {
    "activity": {
      "enum": [
        "awaiting_answer",
        "awaiting_approval",
        "running_tool",
        "thinking",
        "background_work",
        "done",
        "interrupted",
        "errored",
        "idle",
        "unknown"
      ]
    },
    "certainty": {
      "enum": [
        "firm",
        "inferred"
      ]
    },
    "reason": {
      "enum": [
        "no_entries",
        "no_writes_for",
        "ask_user_tool",
        "approval_requested",
        "tool_call_stalled",
        "tool_call_pending",
        "prompt_sent",
        "tool_result_in",
        "turn_ended",
        "interrupted",
        "errored",
        "background_helpers",
        "composer_status"
      ]
    },
    "permission": {
      "enum": [
        "default",
        "accept_edits",
        "plan",
        "bypass_permissions",
        "dont_ask",
        "auto",
        "manual",
        "normal",
        "never",
        "on_request",
        "untrusted",
        "granular_ask",
        "granular_no_ask",
        "unknown"
      ]
    },
    "sandbox": {
      "enum": [
        "danger_full_access",
        "read_only",
        "external_sandbox",
        "workspace_write",
        "unknown"
      ]
    }
  },
  "type": "object",
  "properties": {
    "after_line": {
      "type": "integer",
      "minimum": 0
    },
    "now_offset_s": {
      "type": "number",
      "minimum": 0
    },
    "helper": {
      "type": "string"
    },
    "helper_line": {
      "type": "integer",
      "minimum": 0
    },
    "meta": {
      "type": "string"
    },
    "activity": {
      "$ref": "#/$defs/activity"
    },
    "certainty": {
      "$ref": "#/$defs/certainty"
    },
    "reason": {
      "$ref": "#/$defs/reason"
    },
    "permission": {
      "oneOf": [
        {
          "$ref": "#/$defs/permission"
        },
        {
          "type": "null"
        }
      ]
    },
    "sandbox": {
      "oneOf": [
        {
          "$ref": "#/$defs/sandbox"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "after_line",
    "now_offset_s"
  ],
  "unevaluatedProperties": false
}
