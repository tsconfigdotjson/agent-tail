{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tsconfigdotjson/agent-tail/spec/schema/status.schema.json",
  "title": "agent-tail status checkpoint (v0.1)",
  "description": "One line of a fixture expected/status.jsonl: a timing instruction and an optional expected status.",
  "$defs": {
    "activity": {
      "enum": [
        "awaiting_answer",
        "awaiting_approval",
        "running_tool",
        "thinking",
        "background_work",
        "done",
        "interrupted",
        "errored",
        "idle",
        "unknown"
      ]
    },
    "certainty": {
      "enum": [
        "firm",
        "inferred"
      ]
    },
    "reason": {
      "enum": [
        "no_entries",
        "no_writes_for",
        "ask_user_tool",
        "approval_requested",
        "tool_call_stalled",
        "tool_call_pending",
        "prompt_sent",
        "tool_result_in",
        "turn_ended",
        "interrupted",
        "errored",
        "background_helpers",
        "composer_status"
      ]
    },
    "permission": {
      "enum": [
        "default",
        "accept_edits",
        "plan",
        "bypass_permissions",
        "dont_ask",
        "auto",
        "manual",
        "normal",
        "never",
        "on_request",
        "untrusted",
        "granular_ask",
        "granular_no_ask",
        "unknown"
      ]
    },
    "sandbox": {
      "enum": [
        "danger_full_access",
        "read_only",
        "external_sandbox",
        "workspace_write",
        "unknown"
      ]
    },
    "token_usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_creation_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "unevaluatedProperties": false
    },
    "activity_line": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "prompt"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "command"
            },
            "command": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "command"
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "tool"
            },
            "name": {
              "type": "string"
            },
            "detail": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "helper_state": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "activity": {
          "enum": [
            "awaiting_answer",
            "awaiting_approval",
            "running_tool",
            "thinking",
            "background_work",
            "done",
            "interrupted",
            "errored",
            "idle",
            "unknown"
          ]
        },
        "certainty": {
          "enum": [
            "firm",
            "inferred"
          ]
        },
        "reason": {
          "enum": [
            "no_entries",
            "no_writes_for",
            "ask_user_tool",
            "approval_requested",
            "tool_call_stalled",
            "tool_call_pending",
            "prompt_sent",
            "tool_result_in",
            "turn_ended",
            "interrupted",
            "errored",
            "background_helpers",
            "composer_status"
          ]
        },
        "since": {
          "type": [
            "number",
            "null"
          ]
        },
        "last_write": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "activity",
        "certainty",
        "reason"
      ],
      "unevaluatedProperties": false
    },
    "wakeup_kind": {
      "enum": [
        "loop",
        "cron"
      ]
    },
    "pending_wakeup": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/wakeup_kind"
        },
        "due_at": {
          "type": [
            "number",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "certainty": {
          "$ref": "#/$defs/certainty"
        }
      },
      "required": [
        "kind",
        "certainty"
      ],
      "unevaluatedProperties": false
    }
  },
  "type": "object",
  "properties": {
    "after_line": {
      "type": "integer",
      "minimum": 0
    },
    "now_offset_s": {
      "type": "number",
      "minimum": 0
    },
    "helper": {
      "type": "string"
    },
    "helper_line": {
      "type": "integer",
      "minimum": 0
    },
    "meta": {
      "type": "string"
    },
    "activity": {
      "$ref": "#/$defs/activity"
    },
    "certainty": {
      "$ref": "#/$defs/certainty"
    },
    "reason": {
      "$ref": "#/$defs/reason"
    },
    "permission": {
      "oneOf": [
        {
          "$ref": "#/$defs/permission"
        },
        {
          "type": "null"
        }
      ]
    },
    "sandbox": {
      "oneOf": [
        {
          "$ref": "#/$defs/sandbox"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ]
    },
    "out_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "usage": {
      "$ref": "#/$defs/token_usage"
    },
    "recent": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/activity_line"
      }
    },
    "background": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/helper_state"
      }
    },
    "pending_wakeups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pending_wakeup"
      }
    }
  },
  "required": [
    "after_line",
    "now_offset_s"
  ],
  "unevaluatedProperties": false
}
