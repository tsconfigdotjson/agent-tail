{
  "name": "gemini_tool",
  "description": "Gemini CLI calls run_shell_command, receives its result, then answers.",
  "title": "Run a short tool",
  "steps": [
    {
      "expect": { "user_contains": "use the tool" },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "run_shell_command",
            "input": { "command": "sleep 1; printf gemini-tool-ok" }
          }
        ],
        "usage": { "input_tokens": 11, "output_tokens": 6 }
      }
    },
    {
      "expect": { "tool_result_contains": "gemini-tool-ok" },
      "reply": {
        "content": [{ "type": "text", "text": "The tool ran." }],
        "usage": { "input_tokens": 12, "output_tokens": 7 }
      }
    }
  ]
}
