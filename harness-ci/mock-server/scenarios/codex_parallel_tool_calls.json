{
  "name": "codex_parallel_tool_calls",
  "description": "Three function calls in one response, then a text turn after all outputs.",
  "steps": [
    {
      "expect": { "user_contains": "run three commands" },
      "reply": {
        "content": [
          { "type": "tool_use", "id": "call_parallel_1", "name": "exec_command", "input": { "cmd": "touch parallel-1.txt" } },
          { "type": "tool_use", "id": "call_parallel_2", "name": "exec_command", "input": { "cmd": "touch parallel-2.txt" } },
          { "type": "tool_use", "id": "call_parallel_3", "name": "exec_command", "input": { "cmd": "touch parallel-3.txt" } }
        ],
        "usage": { "input_tokens": 10, "output_tokens": 30 },
        "fault": { "type": "slow_first_token", "delay_ms": 800 }
      }
    },
    {
      "expect": { "has_tool_result": true, "tool_result_id": "call_parallel_3" },
      "reply": {
        "content": [{ "type": "text", "text": "All three commands finished." }],
        "usage": { "input_tokens": 40, "output_tokens": 8 }
      }
    }
  ]
}
