{
  "name": "resume_word",
  "description": "One turn that remembers a word, then a later process asks for it. Sequential: the second request still contains the word.",
  "steps": [
    {
      "expect": {
        "user_contains": "RESUME-WORD-GAMMA",
        "not_user_contains": "what word did I ask"
      },
      "reply": {
        "content": [{ "type": "text", "text": "Noted RESUME-WORD-GAMMA." }],
        "usage": { "input_tokens": 12, "output_tokens": 8 },
        "fault": { "type": "slow_first_token", "delay_ms": 1000 }
      }
    },
    {
      "expect": { "user_contains": "what word did I ask" },
      "reply": {
        "content": [{ "type": "text", "text": "The word is RESUME-WORD-GAMMA." }],
        "usage": { "input_tokens": 40, "output_tokens": 12 },
        "fault": { "type": "slow_first_token", "delay_ms": 800 }
      }
    }
  ]
}
