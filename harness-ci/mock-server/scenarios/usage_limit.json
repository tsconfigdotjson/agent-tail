{
  "name": "usage_limit",
  "description": "HTTP 429 with the provider's usage-limit message on every retry.",
  "steps": [
    {
      "repeat": 12,
      "expect": { "user_contains": "trigger a usage limit" },
      "reply": {
        "content": [{ "type": "text", "text": "unused" }],
        "usage": { "input_tokens": 10, "output_tokens": 1 },
        "fault": { "type": "http", "status": 429, "message": "You've hit your 5-hour limit · resets 3:50am (UTC)" }
      }
    }
  ]
}
