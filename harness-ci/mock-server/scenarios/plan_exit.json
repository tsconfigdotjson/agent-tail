{
  "name": "plan_exit",
  "description": "A read, a Bash write, ToolSearch to load the deferred ExitPlanMode schema, then ExitPlanMode.",
  "steps": [
    {
      "expect": { "user_contains": "plan the change" },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "Read",
            "input": { "file_path": "{{workspace}}/note.txt" }
          }
        ],
        "usage": { "input_tokens": 10, "output_tokens": 20 },
        "fault": { "type": "slow_first_token", "delay_ms": 1000 }
      }
    },
    {
      "expect": { "tool_result_id": "toolu_mock_0_0" },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "Bash",
            "input": {
              "command": "touch {{workspace}}/marker.txt",
              "description": "Create a marker file"
            }
          }
        ],
        "usage": { "input_tokens": 30, "output_tokens": 20 },
        "fault": { "type": "slow_first_token", "delay_ms": 1000 }
      }
    },
    {
      "expect": { "tool_result_id": "toolu_mock_1_0" },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "ToolSearch",
            "input": { "query": "select:ExitPlanMode", "max_results": 1 }
          }
        ],
        "usage": { "input_tokens": 40, "output_tokens": 20 },
        "fault": { "type": "slow_first_token", "delay_ms": 1000 }
      }
    },
    {
      "expect": { "tool_result_id": "toolu_mock_2_0" },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "ExitPlanMode",
            "input": {}
          }
        ],
        "usage": { "input_tokens": 50, "output_tokens": 20 },
        "fault": { "type": "slow_first_token", "delay_ms": 1000 }
      }
    }
  ]
}
