{
  "name": "copilot_parallel_tools",
  "description": "Two bash calls in one assistant message. Both must stay pending until each tool result arrives; the model answers only after the second result.",
  "steps": [
    {
      "expect": { "user_contains": "run both tools" },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "id": "call_parallel_first",
            "name": "bash",
            "input": { "command": "sleep 1; printf first-ok", "description": "Run the first tool" }
          },
          {
            "type": "tool_use",
            "id": "call_parallel_second",
            "name": "bash",
            "input": { "command": "sleep 2; printf second-ok", "description": "Run the second tool" }
          }
        ],
        "usage": { "input_tokens": 10, "output_tokens": 20 },
        "fault": { "type": "slow_first_token", "delay_ms": 500 }
      }
    },
    {
      "expect": { "has_tool_result": true, "tool_result_id": "call_parallel_second" },
      "reply": {
        "content": [{ "type": "text", "text": "Both tools finished." }],
        "usage": { "input_tokens": 20, "output_tokens": 8 },
        "fault": { "type": "slow_first_token", "delay_ms": 500 }
      }
    }
  ]
}
