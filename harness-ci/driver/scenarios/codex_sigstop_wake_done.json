{
  "name": "codex_sigstop_wake_done",
  "description": "Codex completes a turn, its process group is SIGSTOPped at firm done, and after SIGCONT the same process records a second turn.",
  "harness": "codex",
  "mock": "../../mock-server/scenarios/wake_plain_qa.json",
  "prompt": "say hello",
  "freeze": {
    "on_activity": "done",
    "after_ms": 500,
    "for_ms": 3000,
    "resume_send": "say hello again\r"
  },
  "run_for_ms": 18000,
  "expected_activity": [
    { "activity": "done", "when": "ever", "screen": "idle", "certainty": "firm" },
    { "activity": "done", "when": "end", "screen": "idle", "certainty": "firm" }
  ],
  "expect_observations": {
    "codex_approval_policies": ["on-request"],
    "codex_no_approval_events": true
  }
}
