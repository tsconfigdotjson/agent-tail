{
  "name": "claude_sigstop_wake_answer",
  "description": "Claude Code is frozen while an AskUserQuestion is on screen (firm awaiting_answer), then wakes and records the answer's next turn.",
  "harness": "claude_code",
  "mock": "../../mock-server/scenarios/ask_user.json",
  "command": ["claude", "--model", "claude-sonnet-4-5"],
  "prompt": "ask which library",
  "freeze": {
    "on_activity": "awaiting_answer",
    "after_ms": 1000,
    "for_ms": 3000,
    "resume_send": "\r"
  },
  "run_for_ms": 30000,
  "expected_activity": [
    { "activity": "awaiting_answer", "when": "ever", "screen": "ask_user_question", "certainty": "firm" },
    { "activity": "done", "when": "end", "screen": "idle", "certainty": "firm" }
  ]
}
