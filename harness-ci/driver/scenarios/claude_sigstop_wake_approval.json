{
  "name": "claude_sigstop_wake_approval",
  "description": "Claude Code is frozen on a Bash permission prompt after it stalls to inferred awaiting_approval, then wakes and completes the approved turn.",
  "harness": "claude_code",
  "mock": "../../mock-server/scenarios/bash_approval.json",
  "prompt": "run the command",
  "freeze": {
    "on_activity": "awaiting_approval",
    "after_ms": 0,
    "for_ms": 3000,
    "resume_send": "\r"
  },
  "run_for_ms": 50000,
  "expected_activity": [
    { "activity": "awaiting_approval", "when": "ever", "screen": "permission_prompt", "certainty": "inferred" },
    { "activity": "done", "when": "end", "screen": "idle", "certainty": "firm" }
  ]
}
