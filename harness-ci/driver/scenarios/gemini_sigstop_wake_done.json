{
  "name": "gemini_sigstop_wake_done",
  "description": "Gemini CLI interacts in its TUI: after the first done turn the live process is frozen, then a resumed prompt records the next turn without a restart.",
  "harness": "gemini",
  "pty": true,
  "mock": "../../mock-server/scenarios/wake_plain_qa.json",
  "command": [
    "gemini", "--approval-mode", "yolo", "--skip-trust",
    "-i", "say hello"
  ],
  "freeze": {
    "on_activity": "done",
    "after_ms": 500,
    "for_ms": 3000,
    "resume_send": "say hello again\r",
    "resume_delay_ms": 2000,
    "resume_enter_delay_ms": 500
  },
  "run_for_ms": 45000,
  "expected_activity": [
    { "activity": "done", "when": "ever", "certainty": "firm" },
    { "activity": "done", "when": "end", "certainty": "firm" }
  ]
}
