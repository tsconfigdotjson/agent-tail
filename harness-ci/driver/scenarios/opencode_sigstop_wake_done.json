{
  "name": "opencode_sigstop_wake_done",
  "description": "OpenCode interacts in its TUI: after the first done turn the live process is frozen, then a resumed prompt records the next turn without a restart.",
  "harness": "opencode",
  "pty": true,
  "mock": "../../mock-server/scenarios/wake_plain_qa.json",
  "command": [
    "opencode", "--prompt", "say hello", "--auto",
    "-m", "test/test-model"
  ],
  "freeze": {
    "on_activity": "done",
    "after_ms": 500,
    "for_ms": 3000,
    "resume_send": "say hello again\r"
  },
  "run_for_ms": 45000,
  "expected_activity": [
    { "activity": "done", "when": "ever", "certainty": "firm" },
    { "activity": "done", "when": "end", "certainty": "firm" }
  ]
}
