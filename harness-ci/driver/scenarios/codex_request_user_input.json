{
  "name": "codex_request_user_input",
  "description": "Plan mode shows a request_user_input question, then finishes after Enter.",
  "harness": "codex",
  "mock": "../../mock-server/scenarios/codex_request_user_input.json",
  "prompt": "/plan",
  "keys": [
    { "on": "idle", "send": "ask me which color\r", "occurrence": 0, "after_ms": 1500 },
    { "on": "ask_user_question", "send": "\r", "occurrence": 1, "after_ms": 3000 }
  ],
  "run_for_ms": 22000,
  "min_screen_ms": { "ask_user_question": 2500 },
  "expected_activity": [
    { "activity": "awaiting_answer", "when": "ever", "screen": "ask_user_question", "certainty": "firm" },
    { "activity": "done", "when": "end", "screen": "idle", "certainty": "firm" }
  ]
}
